[Unit]
Description=SongBook off-host backup operation: %i
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=songbook
Group=songbook
EnvironmentFile=/etc/songbook/backup.env
LoadCredential=restic-password:/etc/songbook/secrets/restic-password
LoadCredential=backup-ssh-key:/etc/songbook/secrets/backup-ssh-key
ExecStart=/usr/local/libexec/songbook/backup.sh %i
StateDirectory=songbook
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/songbook
