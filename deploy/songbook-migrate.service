[Unit]
Description=Apply SongBook SQLite migrations
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=songbook
Group=songbook
WorkingDirectory=/opt/songbook/current
Environment=ASPNETCORE_ENVIRONMENT=Production
EnvironmentFile=/etc/songbook/songbook.env
LoadCredential=Email__Smtp__Password:/etc/songbook/secrets/gmail-app-password
ExecStart=/usr/bin/dotnet /opt/songbook/current/SongBookApi.Service.dll --migrate
StateDirectory=songbook
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/songbook
