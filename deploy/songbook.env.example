AllowedHosts=YOUR-SUBDOMAIN.duckdns.org
AccountLinks__PublicOrigin=https://YOUR-SUBDOMAIN.duckdns.org
Moderation__BootstrapSuperUserEmail=ADMIN-EMAIL-YOU-CONTROL
ConnectionStrings__SongBookConnection="Data Source=/var/lib/songbook/songbook.db"
DataProtection__KeyDirectory=/var/lib/songbook/keys
Backup__SuccessMarkerPath=/var/lib/songbook/last-backup-success
Email__Smtp__Host=smtp.gmail.com
Email__Smtp__Port=587
Email__Smtp__UserName=YOUR-GMAIL-ADDRESS
Email__Smtp__FromAddress=YOUR-GMAIL-ADDRESS
Email__Smtp__FromName=SongBook
Security__HstsEnabled=false
