<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <!-- Security pin: overrides MimeKit's vulnerable System.Security.Cryptography.Pkcs 10.0.0 dependency. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SongBookApi.Domain\SongBookApi.Domain.csproj" />
    <ProjectReference Include="..\SongBookApi.Infrastructure\SongBookApi.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SongBookApi.Service.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\Fonts\*.ttf" />
    <EmbeddedResource Include="Resources\Fonts\*.ttf" LogicalName="SongBookApi.Service.Fonts.%(Filename)%(Extension)" />
    <None Update="Resources\Fonts\DejaVu-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
